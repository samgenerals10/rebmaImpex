{
  "expo": {
    "name": "REBMA IMPEX",
    "slug": "rebma-mobile",
    "owner": "rebmaimpexmobile",
    "scheme": "rebmaimpex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#22c55e",
    "backgroundColor": "#f0fdf4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rebmaimpex.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rebma Mobile uses your location to share live delivery tracking with dispatch while a delivery is active.",
        "NSMicrophoneUsageDescription": "Rebma Mobile uses your microphone for Boardroom video and voice calls, and to record voice notes in Messenger.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false
    },
    "android": {
      "package": "com.rebmaimpex.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#22c55e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eb143336-0bd6-4aaa-bbcc-01007eb0d340"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rebma Mobile uses your location to share live delivery tracking with dispatch while a delivery is active."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Rebma Mobile uses your camera to scan waybill QR codes and capture proof-of-delivery photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rebma Mobile uses your photo library to attach cargo intake and delivery photos.",
          "cameraPermission": "Rebma Mobile uses your camera to attach cargo intake and delivery photos."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#22c55e"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-video",
      "@config-plugins/react-native-webrtc"
    ],
    "extra": {
      "eas": {
        "projectId": "eb143336-0bd6-4aaa-bbcc-01007eb0d340"
      }
    }
  }
}
