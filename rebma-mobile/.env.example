# ─── REBMA Impex Mobile — Environment Variables ────────────────────────────
# Copy this file to .env in the same folder, then fill in the real values.
# .env itself is git-ignored — it never gets pushed to GitHub.

# ── Supabase Credentials ───────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=...
EXPO_PUBLIC_SUPABASE_ANON_KEY=...

# ── Base URL for the privileged Vercel endpoints (register-staff-user,
#    approve-user, send-staff-invite-email) HR's mobile screens need ───────
EXPO_PUBLIC_API_BASE_URL=...
